#!/bin/sh
set -eu

job_dir=$(mktemp -d "${TMPDIR:-/tmp}/mplab-php-XXXXXXXXXX")
job_name=${job_dir##*/}
rmdir "$job_dir"

exec docker run --rm -i --pull=never --name "$job_name" \
    --network none --read-only --tmpfs /tmp:rw,noexec,nosuid,nodev,size=16m,mode=1777 \
    --user 65534:65534 --cap-drop ALL --security-opt no-new-privileges \
    --pids-limit 32 --memory=256m --memory-swap=256m --cpus=1 \
    mplab-php:local
